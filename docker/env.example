# Copy to .env at the repository root: `cp docker/env.example .env`
#
# Only the ai-bff container reads these. They are the same variables
# services/ai-bff/src/credentials.ts documents, and they never reach the
# browser — /v1/ai/settings reports whether a credential is configured and
# nothing else, which services/ai-bff/tests/no-leak.test.ts asserts by
# generating every substring of the credential of length >= 4 and checking that
# none appears in any response body.
#
# `.env` is gitignored. Keep it that way.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# The active provider id, from @samugen/ai-provider (e.g. anthropic, openai,
# google, custom). Omit to take that package's default.
SAMUGEN_AI_PROVIDER=anthropic

# Per-provider settings. <PROVIDER> is the provider id upper-cased with - -> _.
SAMUGEN_AI_KEY_ANTHROPIC=
# SAMUGEN_AI_MODEL_ANTHROPIC=
# Endpoint override, for custom or self-hosted providers.
# SAMUGEN_AI_BASE_URL_ANTHROPIC=
# Extra request headers as a JSON object, for gateways that need caller
# attribution. A malformed value stops the service rather than being skipped.
# SAMUGEN_AI_HEADERS_ANTHROPIC={"X-Caller":"samugen"}

# Output token ceiling per turn (default 8192).
# SAMUGEN_AI_BFF_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
# The BFF has no entry here on purpose: it is not published to the host.
# SAMUGEN_SHELL_PORT=8080
# SAMUGEN_DOCS_PORT=8081
# SAMUGEN_PDF_PORT=8082
