{
  "name": "@samugen/hwpx-convert",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "HWPX import/export codecs: .hwpx bytes to the restricted HTML fragment docs' editor consumes, and back again",
  "exports": {
    ".": "./src/index.ts",
    "./formats": "./src/formats.ts",
    "./text": "./src/text.ts",
    "./vite": "./vite.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:template": "tsx scripts/generate-template.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.4",
    "html2hwpx": "github:shreyanshu09/HanForge#d7b47ce",
    "htmlparser2": "^9.1.0",
    "jszip": "^3.10.1",
    "neoali-hwpxjs": "github:ALI-startup/neoali-hwpxjs#c6c8dae"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "domhandler": "^5.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
