{
  "name": "@samugen/shell",
  "productName": "SamuGen",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Unified SamuGen shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@samugen/agent-core": "*",
    "@samugen/ai-electron": "*",
    "@samugen/ai-provider": "*",
    "@samugen/ai-search": "*",
    "@samugen/docs": "*",
    "@samugen/docx-engine": "*",
    "@samugen/electron-utils": "*",
    "@samugen/i18n": "*",
    "@samugen/platform": "*",
    "@samugen/platform-web": "*",
    "@samugen/pptx-engine": "*",
    "@samugen/pptx-render": "*",
    "@samugen/sheets": "*",
    "@samugen/slides": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "SamuGen",
  "dependencies": {
    "@samugen/ui": "*",
    "simple-icons": "^16.28.0"
  }
}
